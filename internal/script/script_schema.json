{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "runs"
  ],
  "properties": {
    "version": {
      "description": "Script format version, MAJOR.MINOR. A minor increase is additive and older scripts keep working; a major increase means existing scripts must be rewritten. prescript rejects a version it does not recognise rather than ignoring what it cannot read. See docs/script-format.md.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arguments",
          "exitCode",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "type": "number"
          },
          "env": {
            "description": "Environment for the child process. Omit it and the child inherits prescript's environment. Declare it and the child gets exactly these variables and nothing else, unless inheritEnv is also set. Added in 0.2.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "inheritEnv": {
            "description": "Put prescript's own environment underneath the declared env, rather than replacing it. Has no effect unless env is declared. Added in 0.2.",
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "line"
              ],
              "properties": {
                "line": {
                  "type": "string"
                },
                "input": {
                  "type": "string"
                },
                "isRegex": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  }
}