{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "runs"
  ],
  "properties": {
    "version": {
      "description": "Script format version, MAJOR.MINOR. A minor increase is additive and older scripts keep working; a major increase means existing scripts must be rewritten. prescript rejects a version it does not recognise rather than ignoring what it cannot read. See docs/script-format.md.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arguments",
          "exitCode",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "line"
              ],
              "properties": {
                "line": {
                  "type": "string"
                },
                "input": {
                  "type": "string"
                },
                "isRegex": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  }
}