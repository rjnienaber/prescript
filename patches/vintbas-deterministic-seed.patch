+-- | Seeds the BASIC random number generator.
+--
+-- Upstream seeds this from the wall clock, both once at startup and again on
+-- every @RANDOMIZE@ statement, which makes every run of a program different.
+-- That is fine for playing games and useless for testing them, so this build
+-- takes the seed from the @VINTBAS_SEED@ environment variable instead,
+-- defaulting to 0 when it is unset or unparseable.
+--
+-- Determinism is the default on purpose: an unset variable must not silently
+-- restore clock seeding, or a fixture would pass locally and fail at random.
+-- Set @VINTBAS_SEED@ to vary the sequence deliberately.
 seedRandomFromTime :: Code ()
-seedRandomFromTime = secondsSinceMidnight >>= seedRandom
+seedRandomFromTime = do
+    envSeed <- liftIO (lookupEnv "VINTBAS_SEED")
+    seedRandom (fromMaybe 0 (envSeed >>= readMaybe))
 
