       return x = CPST (\k -> k x)
       (CPST mx) >>= f = CPST (\k -> mx (\x -> unCPST (f x) k))
 
+-- Before GHC 8.6, a failable pattern bind in a do block used Monad's own
+-- `fail`, which defaulted to `error`. GHC 8.6 moved `fail` to MonadFail and
+-- made the desugaring demand an instance, so the interpreter's pattern binds
+-- (e.g. @(FloatVal index) <- getScalarVar control@) no longer compile without
+-- one. This instance restores exactly the previous behaviour.
+instance MonadFail (CPST o m) where
+      fail msg = CPST (\_ -> error msg)
+
